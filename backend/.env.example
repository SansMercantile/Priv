# Binance
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================

MPETI_APP_URL=http://mpeti-core-service:8000
MEZZO_APP_URL=http://mezzo-anima-service:8003
INPU_APP_URL=http://anubis-service:8004

